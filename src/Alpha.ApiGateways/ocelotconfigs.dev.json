{
    "Routes": [
        {
            "DownstreamPathTemplate": "/api/WinLoss/{everything}",
            "DownstreamScheme": "http",
            "DownstreamHostAndPorts": [
                {
                    "Host": "alpha_api_LOCAL",
                    "Port": 5000
                }
            ],
            "UpstreamPathTemplate": "/WinLoss/{everything}",
            "UpstreamHttpMethod": ["GET"],
            "AuthenticationOptions": {
                "AuthenticationProviderKey": "BasicAuthentication",
                "AllowedScopes": ["super", "master"]
            },
            "RouteClaimsRequirement": {
                "scope": "super"
            },
            "RateLimitOptions": {
                "ClientWhitelist": [],
                "EnableRateLimiting": true,
                "Period": "10s",
                "PeriodTimespan": 10,
                "Limit": 2
            }
        }
    ],
    "GlobalConfiguration": {
        "RateLimitOptions": {
            "DisableRateLimitHeaders": false,
            "QuotaExceededMessage": "Too many requests!",
            "HttpStatusCode": 429,
            "ClientIdHeader": "Key"
        }
    }
}
