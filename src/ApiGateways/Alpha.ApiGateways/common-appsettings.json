{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "Serilog": {
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Information",
                "System": "Warning"
            }
        }
    },
    "RateLimitConfigs": {
        "RateLimitByGlobal": {
            "AutoReplenishment": true,
            "PermitLimit": 250,
            "Window": 1,
            "Unit": "s",
            "SegmentsPerWindow": 1
        },
        "RateLimitBySecond": {
            "AutoReplenishment": true,
            "PermitLimit": 100,
            "Window": 1,
            "Unit": "s",
            "SegmentsPerWindow": 1
        },
        "RateLimitByMinute": {
            "AutoReplenishment": true,
            "PermitLimit": 5000,
            "Window": 1,
            "Unit": "m",
            "SegmentsPerWindow": 3
        },
        "RateLimitByHour": {
            "AutoReplenishment": true,
            "PermitLimit": 50000,
            "Window": 1,
            "Unit": "h",
            "SegmentsPerWindow": 6
        }
    }
}